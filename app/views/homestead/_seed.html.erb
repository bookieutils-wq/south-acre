<article class="seed" style="--fruit: <%= crop.hue %>">
  <div class="seed__swatch" aria-hidden="true"></div>
  <div class="seed__copy">
    <h3><%= crop.name %></h3>
    <p><%= crop.summary %></p>
    <dl>
      <div>
        <dt>Grows</dt>
        <dd><%= format_duration(crop.seconds) %></dd>
      </div>
      <div>
        <dt>Seed</dt>
        <dd><%= crop.seed_cost %></dd>
      </div>
      <div>
        <dt>Sells</dt>
        <dd><%= crop.harvest_value %></dd>
      </div>
    </dl>
  </div>
  <%= button_to plant_label(homestead, crop),
        plant_next_plot_path,
        method: :post,
        params: { crop_key: crop.key },
        disabled: !homestead.can_plant?(crop),
        class: "action",
        form: { class: "seed__form", data: { turbo_frame: "homestead_board" } } %>
</article>
